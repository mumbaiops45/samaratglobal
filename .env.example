# Copy to .env.local for local testing, and add the same keys in your host's
# environment-variable settings (Vercel: Project > Settings > Environment Variables).
# Never commit the real values.

# SMTP server of the mailbox that sends the enquiries
#   Hostinger mail: smtp.hostinger.com   GoDaddy (Microsoft 365): smtp.office365.com
#   Gmail / Google Workspace: smtp.gmail.com (needs a 16-character App Password)
SMTP_HOST=smtp.hostinger.com
# 465 = SSL/TLS, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=globalhead29@gmail.com
SMTP_PASS=

# Where enquiries are delivered (defaults to SMTP_USER if left empty)
CONTACT_TO=globalhead29@gmail.com
